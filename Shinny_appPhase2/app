# ==============================================================================
# 4. SERVER SIDE LOGIC
# ==============================================================================

server <- function(input, output, session) {
  
  # Reactive State Machine: Manages data flow and API status
  state <- reactiveValues(
    api_connected = FALSE,
    cpgs = NULL,  
    info = NULL   
  )
  
  # ----------------------------------------------------------------------------
  # A. ROBUST INITIALIZATION & HANDSHAKE PROTOCOL
  # ----------------------------------------------------------------------------
  observe({
    # 1. Connection Check
    connected <- check_api_status()
    state$api_connected <- connected
    
    # 2. Auto-Retry Logic: If disconnected, try again in 3 seconds
    if (!connected) {
      invalidateLater(3000, session)
    } else if (is.null(state$cpgs)) {
      # 3. HANDSHAKE & DYNAMIC DISCOVERY
      # Once connected, we perform a "handshake" with the API to configure the UI.
      
      tryCatch({
        # Step A: Get Model Metadata (Algorithm type, required CpGs)
        info_res <- GET(paste0(API_URL, "/model-info"))
        info_data <- fromJSON(content(info_res, "text", encoding = "UTF-8"))
        
        state$info <- info_data
        state$cpgs <- info_data$cpg_sites 
        
        # Step B: Discover Valid Factor Levels (The "Smart Client" Logic)
        # We send a dummy payload intentionally. The API validates it and returns
        # the correct factor levels (e.g., "Male" vs "M") in the error response.
        # This prevents hardcoding values in the app.
        dummy_payload <- list(
          M_values = rep(0, length(state$cpgs)),
          age = 75,
          sex = "__DISCOVERY__",
          cell_type = "__DISCOVERY__",
          region = "__DISCOVERY__"
        )
        
        dummy_res <- POST(
          url = paste0(API_URL, "/predict"),
          body = dummy_payload,
          encode = "json"
        )
        
        # Capture the metadata from the 400 Bad Request response
        if (status_code(dummy_res) == 400) {
          err <- fromJSON(content(dummy_res, "text", encoding = "UTF-8"))
          
          # Dynamic UI Update: Populate dropdowns with API-provided levels
          if (!is.null(err$valid_levels$sex)) {
            updateSelectInput(session, "input_sex",
                              choices = setNames(err$valid_levels$sex, err$valid_levels$sex),
                              selected = err$valid_levels$sex[1])
          }
          if (!is.null(err$valid_levels$cell_type)) {
            updateSelectInput(session, "input_cell_type",
                              choices = setNames(err$valid_levels$cell_type, err$valid_levels$cell_type),
                              selected = err$valid_levels$cell_type[1])
          }
          if (!is.null(err$valid_levels$region)) {
            updateSelectInput(session, "input_region",
                              choices = setNames(err$valid_levels$region, err$valid_levels$region),
                              selected = err$valid_levels$region[1])
          }
          showNotification("System synchronized with Model API.", type = "message")
        }
        
      }, error = function(e) {
        showNotification("Warning: Model discovery handshake failed.", type = "warning")
      })
    }
  })
  
  # Update UI elements based on connection status
  output$api_connected <- reactive({ state$api_connected })
  output$sliders_ready <- reactive({ !is.null(state$cpgs) })
  outputOptions(output, "api_connected", suspendWhenHidden = FALSE)
  outputOptions(output, "sliders_ready", suspendWhenHidden = FALSE)
  
  # Status Icon Logic
  output$connection_status_ui <- renderUI({
    if(state$api_connected) {
      tagList(icon("check-circle", style = "color: green; font-size: 2em;"),
              h5("System Online", style = "color: green;"))
    } else {
      tagList(icon("times-circle", style = "color: red; font-size: 2em;"),
              h5("API Offline", style = "color: red;"))
    }
  })
  
  # ----------------------------------------------------------------------------
  # B. DYNAMIC INPUT GENERATION
  # ----------------------------------------------------------------------------
  # Automatically creates a slider for each CpG site defined in the API metadata
  output$cpg_sliders_ui <- renderUI({
    req(state$cpgs)
    
    ui_elements <- lapply(1:length(state$cpgs), function(i) {
      cpg_id <- state$cpgs[i]
      div(style = "background-color: #f7f7f7; padding: 10px; margin-bottom: 10px; border-radius: 5px; border-left: 3px solid #18bc9c;",
          strong(paste("Biomarker", i, ":", cpg_id)),
          sliderInput(inputId = paste0("cpg_", i), 
                      label = "Methylation Level (Beta Value)", 
                      min = 0, max = 1, value = 0.5, step = 0.01, ticks = FALSE)
      )
    })
    do.call(tagList, ui_elements)
  })
  
  # ----------------------------------------------------------------------------
  # C. PREDICTION LOGIC & DATA TRANSFORMATION
  # ----------------------------------------------------------------------------
  
  # DATA TRANSFORMATION THEORY:
  # The UI uses Beta values (0-1) for interpretability. 
  # The Backend Model uses M-values (Log2 Ratio) for statistical homoscedasticity.
  # This function handles the necessary transformation before API transmission.
  beta_to_m <- function(beta) {
    beta <- ifelse(beta <= 0, 0.001, beta)
    beta <- ifelse(beta >= 1, 0.999, beta)
    return(log2(beta / (1 - beta)))
  }
  
  observeEvent(input$btn_predict, {
    req(state$api_connected, state$cpgs)
    
    # 1. Validation: Ensure all inputs are loaded
    if (input$input_sex == "" || input$input_region == "") {
      showNotification("Please wait for model options to load...", type = "warning")
      return() 
    }
    
    # 2. Prepare Payload: Convert Beta inputs to M-values
    m_values_input <- numeric(length(state$cpgs))
    for(i in 1:length(state$cpgs)) {
      m_values_input[i] <- beta_to_m(input[[paste0("cpg_", i)]])
    }
    
    payload <- list(
      M_values = m_values_input,
      age = input$input_age,
      sex = input$input_sex,
      cell_type = input$input_cell_type,
      region = input$input_region
    )
    
    # 3. API Call: Send data to Backend
    withProgress(message = 'Analyzing...', value = 0.5, {
      tryCatch({
        res <- POST(url = paste0(API_URL, "/predict"), body = payload, encode = "json")
        
        if (status_code(res) == 200) {
          result_data <- fromJSON(content(res, "text", encoding = "UTF-8"))
          
          # 4. Render Results
          prob <- result_data$prediction$probability_AD
          output$pred_prob_text <- renderText({ result_data$prediction$probability_percent })
          output$pred_recommendation <- renderText({ result_data$clinical_interpretation$recommendation })
          
          # Risk Level Badge
          output$risk_badge <- renderUI({
            lvl <- result_data$prediction$risk_level
            color <- switch(lvl, "LOW" = "#27ae60", "MODERATE" = "#f39c12", "HIGH" = "#c0392b")
            div(style = paste0("background-color:", color, "; color: white; padding: 5px 15px; border-radius: 20px; display: inline-block; margin-top: 10px;"),
                strong(paste("Risk Category:", lvl))
            )
          })
          
          # Visualization
          output$contribution_plot <- renderPlot({
            df <- data.frame(Metric = "Patient Risk", Value = prob)
            ggplot(df, aes(x=Metric, y=Value)) +
              geom_col(fill = ifelse(prob > 0.5, "#c0392b", "#27ae60"), width = 0.3) +
              geom_hline(yintercept = 0.5, linetype = "dashed", color = "gray50") +
              annotate("text", x=1.4, y=0.52, label="Clinical Cutoff (0.5)", color="gray40") +
              scale_y_continuous(limits = c(0, 1), labels = scales::percent) +
              coord_flip() +
              labs(title = "Probability vs Decision Threshold", y = "Probability", x = "") +
              theme_minimal() + theme(plot.title = element_text(face="bold"))
          })
          
        } else {
          # Error Handling: Show specific API error message
          api_error <- content(res, "text", encoding = "UTF-8")
          showNotification(paste("API Error:", api_error), type = "error", duration = 10)
        }
      }, error = function(e) {
        showNotification("Communication breakdown: API did not respond.", type = "error")
      })
    })
  })
  
  # ----------------------------------------------------------------------------
  # D. METADATA & VALIDATION TABS
  # ----------------------------------------------------------------------------
  
  # Render General Model Information as a formatted list
  output$model_info_ui <- renderUI({
    req(state$info)
    info <- state$info
    
    tagList(
      tags$ul(
        tags$li(strong("Algorithm: "), info$model_type),
        tags$li(strong("Target: "), info$outcome),
        tags$li(strong("Dataset: "), info$dataset),
        tags$li(strong("Input Features: "), paste(info$n_predictors, "total (", info$n_cpg_sites, "CpG sites + covariates)")),
        tags$li(strong("Selected CpGs: "), paste(info$cpg_sites, collapse=", ")),
        tags$li(strong("Note: "), info$note)
      )
    )
  })
  
  # Render Performance Metrics Table (Formatted cleanly)
  output$model_metrics_table <- renderTable({
    req(state$info)
    metrics <- state$info$performance
    
    if(!is.null(metrics) && is.list(metrics)) {
      data.frame(
        Metric = c("Test Accuracy", "Sensitivity", "Specificity", "PPV", "NPV"),
        Value = c(
          paste0(metrics$test_accuracy, "%"), 
          paste0(metrics$test_sensitivity, "%"), 
          paste0(metrics$test_specificity, "%"),
          paste0(metrics$test_ppv, "%"),
          paste0(metrics$test_npv, "%")
        )
      )
    } else {
      data.frame(Status = "Metrics not available")
    }
  })
}

# Run the application 
shinyApp(ui = ui, server = server)
