# 2. NETWORK CONFIGURATION (Docker & Local Support)
# ==============================================================================

# API Endpoint Logic:
# The app checks if it's running inside a Docker container (reading system env vars).
# If not (local RStudio), it defaults to localhost. This allows seamless transitions
# between development (Phase 2) and deployment (Phase 3).
API_URL <- Sys.getenv("API_URL")
if (API_URL == "") {
  API_URL <- "http://127.0.0.1:8000" 
}

# HEALTH CHECK FUNCTION:
# Acts as a "Ping". It verifies if the Backend is online before loading the UI.
check_api_status <- function() {
  tryCatch({
    res <- GET(paste0(API_URL, "/health"), timeout(2))
    return(status_code(res) == 200)
  }, error = function(e) {
    return(FALSE)
  })
}

